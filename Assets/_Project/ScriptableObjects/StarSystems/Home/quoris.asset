    \u0441\u043B\u043E\u0439, \u0440\u0436\u0430\u0432\u044B\u0435 \u043A\u0440\u0430\u0441\u043D\u044B\u0435
    \u043F\u044F\u0442\u043D\u0430, \u043C\u0430\u0441\u0441\u0438\u0432\u043D\u044B\u0435
    \u0433\u043B\u0443\u0431\u043E\u043A\u0438\u0435 \u043A\u0440\u0430\u0442\u0435\u0440\u044B
    \u0438 \xAB\u0441\u0435\u0440\u0434\u0435\u0447\u043A\u043E\xBB."
