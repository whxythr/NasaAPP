    \u043F\u0443\u0441\u0442\u044B\u043D\u0438, \u0433\u043E\u0440\u044B \u0443 \u044D\u043A\u0432\u0430\u0442\u043E\u0440\u0438\u0430\u043B\u044C\u043D\u044B\u0445
    \u043F\u043E\u0431\u0435\u0440\u0435\u0436\u0438\u0439, \u043D\u0430 \u043F\u043E\u043B\u044E\u0441\u0430\u0445
    \u0434\u043E \u221249 \xB0C. \u0421\u043F\u043B\u044E\u0441\u043D\u0443\u0442\u043E\u0441\u0442\u044C
    0.286 %, \u043D\u0430\u043A\u043B\u043E\u043D \u043E\u0441\u0438 22.5\xB0, \u043C\u0430\u0433\u043D\u0438\u0442\u043D\u044B\u0439
    \u043F\u043E\u043B\u044E\u0441 11.5\xB0, B = 0.254 \u0413\u0441, \u043C\u0430\u0433\u043D\u0438\u0442\u043E\u043F\u0430\u0443\u0437\u0430
