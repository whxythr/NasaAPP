<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Runs the SAME NUnit test sources that Unity's EditMode test runner uses (Assets/_Project/Tests/EditMode/Core),
    so the physics core can be verified without the Unity Editor:  dotnet test Tools/CoreTests
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../Assets/_Project/Tests/EditMode/Core/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.5.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../SpaceSim.Core/SpaceSim.Core.csproj" />
  </ItemGroup>
</Project>
